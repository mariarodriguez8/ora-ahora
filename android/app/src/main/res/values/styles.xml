<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mostrado como splash mientras Android infla la primera
         Activity de Flutter (MainActivity). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema usado por MainActivity una vez que Flutter ya se dibujó. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Tema para PrayerGateActivity: pantalla completa, sin action bar,
         para que la pausa de oración se sienta como un momento aparte. -->
    <style name="PrayerGateTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/gate_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Boton de opcion de animo en el check-in de PrayerGateActivity:
         mismo acento que el boton "Continuar", pero mas bajo/compacto ya
         que hay 6 en pantalla y deben verse como opciones equivalentes,
         no como una llamada a la accion unica. -->
    <style name="GateMoodButton" parent="@android:style/Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:backgroundTint">@color/gate_accent</item>
        <item name="android:textColor">@color/gate_text</item>
    </style>
</resources>
