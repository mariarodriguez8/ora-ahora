<?xml version="1.0" encoding="utf-8"?>
<!-- La Puerta del Redil: pantalla que se muestra al abrir una app elegida.
     Rediseño 2026: degradado de marca, ovejita, nombre, oración corta,
     contador de 10s y botón de victoria. Sin encuesta de ánimo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gate_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/textTargetApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UN MOMENTO"
            android:textColor="#D9B37C"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <!-- Ovejita grande, la protagonista -->
        <ImageView
            android:id="@+id/imageSheep"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ovejita_puerta"
            android:contentDescription="Ovejita" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <!-- Nombre + saludo -->
        <TextView
            android:id="@+id/textGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Espera un momento"
            android:textColor="#F7F3EA"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- Oración corta -->
        <TextView
            android:id="@+id/textPrayerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F0ECE0"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.35"
            android:gravity="center" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón principal: contador -> continuar -->
        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Espera 10s..."
            android:textColor="#241F10"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/gate_button_gold" />

        <!-- Botón de victoria: mejor no entro -->
        <TextView
            android:id="@+id/buttonSnooze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mejor lo dejo 🕊️"
            android:textColor="#DCE8DE"
            android:textSize="15sp"
            android:padding="14dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</FrameLayout>
